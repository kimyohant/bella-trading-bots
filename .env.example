# bottrade environment — copy to .env and fill in only what you use.
#
# Nothing here is required for paper trading. These are for the optional
# LLM sentiment scorer and for a future live-trading adapter.
#
# Env vars override config.toml using BOTTRADE__<SECTION>__<KEY>.

# --- optional: LLM sentiment scorer -----------------------------------------
# Any OpenAI-compatible endpoint. Then set sentiment.model = "llm" in config.toml.
# BOTTRADE_LLM_KEY=sk-...
# OPENAI_API_KEY=sk-...

# --- config overrides (examples) --------------------------------------------
# BOTTRADE__PORTFOLIO__STARTING_CASH=5000
# BOTTRADE__RUN__TICK_SECONDS=30
# BOTTRADE__RISK__KELLY_FRACTION=0.15
# BOTTRADE__SIGNAL__MIN_EDGE=0.08
# BOTTRADE__SENTIMENT__NEWS_ENABLED=true

# --- NOT used by this project (paper trading only) --------------------------
# Kept as documentation of what a live adapter would need. Never commit keys.
# POLYMARKET_PRIVATE_KEY=0x...
# POLYMARKET_FUNDER_ADDRESS=0x...
# SOLANA_RPC_URL=https://...
# SOLANA_PRIVATE_KEY=...
